{
    "name": "toohamster/ws-http",
    "description": "ws-http: Simplified, lightweight HTTP client library with assertion and scenario-based API testing engine, multi-provider agent orchestration (NanoGpt) and scenario-as-data-function outputs",
    "keywords": ["http", "ws-http", "curl", "api-testing", "assertion", "llm", "ai-agent", "openai", "chatgpt", "tool-use"],
    "license": "MIT",
    "homepage": "https://github.com/toohamster/ws-http",
    "support": {
        "issues": "https://github.com/toohamster/ws-http/issues",
        "source": "https://github.com/toohamster/ws-http"
    },
    "authors": [
        {
            "name": "toohamster",
            "email": "449211678@qq.com"
        }
    ],
    "require": {
        "php": "^7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9"
    },
    "autoload": {
        "psr-4": {
            "Ws\\Http\\": "src/Ws/Http"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ws\\Http\\Tests\\": "tests"
        }
    },
    "bin": [
        "bin/ws-http"
    ],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
